# Copy this file to .env and replace the placeholder. .env is gitignored, so a
# real password is never committed. Values here are read by docker-compose.yml.

# Required: the container listens on every interface, so MiniRedis refuses to
# start without a password.
MINIREDIS_PASSWORD=change-me

# Journal durability mode: always, everysec or no.
MINIREDIS_APPENDFSYNC=everysec

# Log level: debug, info, warn or error.
MINIREDIS_LOG_LEVEL=info
